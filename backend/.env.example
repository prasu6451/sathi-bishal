# SATHI Backend Environment Configuration

# Database Configuration (MySQL 8+ with fallback to SQLite for offline testing)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/sathi

# AI Model Configuration
MODEL_DIR=../ai/saved_models/current
MODEL_VERSION=xgb-v1

# Periodic Risk Monitoring Configuration
RISK_UPDATE_INTERVAL_SECONDS=60

# Simulation Mode (Development testing)
SIMULATION_MODE=false

# Weather API Configuration
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=

# Application Security & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
